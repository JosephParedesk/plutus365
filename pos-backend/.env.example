# Copiar a .env en esta misma carpeta (pos-backend/) antes de correr
# `docker-compose up`. Este stack usa un MySQL nuevo y vacío dentro del
# contenedor — NO apunta a tu base de datos real. Sirve para validar que
# las imágenes de monolito-modular y gateway arrancan y se conectan bien.
DB_PASSWORD=elige-una-clave-para-el-mysql-de-prueba
JWT_SECRET=genera-un-secreto-largo-y-aleatorio

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

CERT_ENCRYPTION_KEY=genera-con-openssl-rand-base64-32
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FRONTEND_URL=http://localhost:5173
