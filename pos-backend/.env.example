# Copiar a .env en esta misma carpeta (pos-backend/) antes de correr
# `docker-compose up`. En local, MySQL arranca nuevo y vacío dentro del
# contenedor. En el EC2 de producción, este mismo .env (con secretos reales)
# es lo único que cambia: el volumen mysql_data ahí SÍ es la base real.
DB_PASSWORD=elige-una-clave-para-el-mysql-de-prueba
JWT_SECRET=genera-un-secreto-largo-y-aleatorio

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

CERT_ENCRYPTION_KEY=genera-con-openssl-rand-base64-32
FACTUS_BASE_URL=https://api.factus.com.co
FACTUS_SANDBOX_URL=https://api-sandbox.factus.com.co
FRONTEND_URL=https://d1ka2jc45bx001.cloudfront.net

# El dominio para HTTPS se configura directo en pos-backend/Caddyfile (no acá) —
# ver el comentario de ese archivo.
